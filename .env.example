# The game and offline history guide work without credentials.
PORT=3000
ENABLE_AI=false
GEMINI_API_KEY=
# Enable only after verifying provider access and billing for your account.
GEMINI_TEXT_MODEL=gemini-flash-latest
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_VIDEO_MODEL=gemini-omni-1.1-flash
# Set to the exact public origin when hosting behind a reverse proxy.
APP_URL=http://localhost:3000
