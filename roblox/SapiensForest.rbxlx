<?xml version='1.0' encoding='utf-8'?>
<roblox version="4">
  <External>null</External>
  <External>nil</External>
  <Item class="Workspace" referent="RBX3">
    <Properties>
      <string name="Name">Workspace</string>
    </Properties>
  </Item>
  <Item class="ReplicatedStorage" referent="RBX6">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="RBX9">
      <Properties>
        <string name="Name">Sapiens</string>
      </Properties>
      <Item class="ModuleScript" referent="RBX12">
        <Properties>
          <string name="Name">Config</string>
          <ProtectedString name="Source">return {
    Title = "Sapiens: The Forest of Stories",
    LaneWidth = 7, Speed = 28, Length = 900,
    JumpDuration = 0.85, JumpHeight = 8, SlideDuration = 0.9,
    RespawnSeconds = 2, SuppliesRequired = 8,
    -- Upload the included WAVs to YOUR Roblox account and grant this experience permission.
    Audio = { Music = 0, Pickup = 0, Hit = 0, Discovery = 0 },
    EnableStudioSaves = false,
    DataStoreName = "SapiensForest_v1",
}
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX16">
        <Properties>
          <string name="Name">Rules</string>
          <ProtectedString name="Source">-- Pure Lua/Luau module. No Roblox services, suitable for deterministic tests.
local Rules = {}
function Rules.new()
    return { distance=0, x=0, lane=0, hits=0, supplies=0, knowledge=0,
        jump=0, slide=0, mode="ready", insight=false, collected={}, struck={},
        best=0, wins=0, storySeen=false }
end
function Rules.respawn(s)
    s.distance=0; s.x=0; s.lane=0; s.hits=0; s.jump=0; s.slide=0
    s.struck={}; s.mode="running"
end
function Rules.input(s, action, c)
    if s.mode~="running" then return false end
    if action=="left" then s.lane=math.max(-1,s.lane-1)
    elseif action=="right" then s.lane=math.min(1,s.lane+1)
    elseif action=="jump" and s.jump==0 and s.slide==0 then s.jump=c.JumpDuration
    elseif action=="slide" and s.jump==0 and s.slide==0 then s.slide=c.SlideDuration
    else return false end
    return true
end
function Rules.height(s,c)
    if s.jump&lt;=0 then return 0 end
    return math.sin(math.pi*(1-s.jump/c.JumpDuration))*c.JumpHeight
end
function Rules.hit(s,id)
    if s.mode~="running" or s.struck[id] then return false end
    s.struck[id]=true; s.hits=s.hits+1
    if s.hits&gt;=2 then s.mode="dead" end
    return true
end
function Rules.collect(s,id)
    if s.mode~="running" or s.collected[id] then return false end
    s.collected[id]=true; s.supplies=s.supplies+1
    return true
end
function Rules.answer(s,choice)
    if s.mode~="story" or choice~=1 then return false end
    if not s.insight then s.insight=true; s.knowledge=s.knowledge+12 end
    s.storySeen=true; s.mode="running"
    return true
end
function Rules.step(s,dt,c,obstacles,supplies)
    if s.mode~="running" then return nil end
    dt=math.min(math.max(dt,0),0.05)
    local before=s.distance
    s.distance=math.min(c.Length,s.distance+c.Speed*dt)
    s.best=math.max(s.best,math.floor(s.distance))
    s.x=s.x+(s.lane*c.LaneWidth-s.x)*math.min(1,dt*14)
    s.jump=math.max(0,s.jump-dt); s.slide=math.max(0,s.slide-dt)
    local event=nil
    for _,o in ipairs(obstacles) do
        if before&lt;=o.d+2 and s.distance&gt;=o.d-2 and math.abs(s.x-o.lane*c.LaneWidth)&lt;2.5 then
            local safe=(o.kind=="jump" and Rules.height(s,c)&gt;3) or (o.kind=="slide" and s.slide&gt;0)
            if not safe and Rules.hit(s,o.id) then event="Hit" end
        end
    end
    if s.mode=="dead" then return "Death" end
    for _,p in ipairs(supplies) do
        if before&lt;=p.d+2 and s.distance&gt;=p.d-2 and math.abs(s.x-p.lane*c.LaneWidth)&lt;2.8 then
            if Rules.collect(s,p.id) then event=event or "Pickup" end
        end
    end
    if s.distance&gt;=180 and not s.storySeen then s.mode="story";return "Story" end
    if s.distance&gt;=c.Length then
        if s.supplies&gt;=c.SuppliesRequired and s.insight then s.mode="complete";s.wins=s.wins+1;return "Complete" end
        s.mode="return";return "Return"
    end
    return event
end
return Rules
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBX20">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="RBX23">
      <Properties>
        <string name="Name">SapiensServer</string>
      </Properties>
      <Item class="ModuleScript" referent="RBX26">
        <Properties>
          <string name="Name">World</string>
          <ProtectedString name="Source">local World={}
local function part(parent,name,size,position,color,material)
    local p=Instance.new("Part");p.Name=name;p.Size=size;p.Position=position
    p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.Material=material or Enum.Material.Slate
    p.Color=Color3.fromRGB(color[1],color[2],color[3]);p.Parent=parent
    return p
end
function World.build(c)
    local folder=Instance.new("Folder");folder.Name="SapiensForest";folder.Parent=workspace
    local light=game:GetService("Lighting")
    light.ClockTime=0;light.Brightness=2;light.Ambient=Color3.fromRGB(32,65,60)
    light.OutdoorAmbient=Color3.fromRGB(23,43,61)
    local atmosphere=Instance.new("Atmosphere");atmosphere.Density=.32;atmosphere.Color=Color3.fromRGB(61,112,102);atmosphere.Decay=Color3.fromRGB(12,32,51);atmosphere.Parent=light
    local bloom=Instance.new("BloomEffect");bloom.Intensity=.35;bloom.Size=20;bloom.Threshold=1.1;bloom.Parent=light
    local track=part(folder,"Stone trail",Vector3.new(25,2,c.Length+70),Vector3.new(0,-1,-c.Length/2),{39,66,59})
    track.CanCollide=true
    local rng=Random.new(7301)
    for d=0,c.Length,30 do
        for _,side in ipairs({-1,1}) do
            local x=side*(20+rng:NextNumber(0,8))
            local tree=part(folder,"Ancient trunk",Vector3.new(3,18,3),Vector3.new(x,9,-d),{22,49,39},Enum.Material.Wood)
            tree.Orientation=Vector3.new(0,0,side*8)
            local crown=part(folder,"Canopy",Vector3.new(15,9,14),Vector3.new(x,21,-d),{25,rng:NextInteger(70,105),67},Enum.Material.Grass)
            crown.Shape=Enum.PartType.Ball
            local vine=part(folder,"Luminous vine",Vector3.new(.14,10,.14),Vector3.new(x-side*4,15,-d),{44,154,132},Enum.Material.Neon)
            local rock=part(folder,"Trail crystal",Vector3.new(.7,2,.7),Vector3.new(side*13,1,-d),{51,136,160},Enum.Material.Neon)
            rock.Orientation=Vector3.new(0,45,side*16)
        end
        for lane=-1,1 do
            part(folder,"Paving",Vector3.new(6.4,.08,10),Vector3.new(lane*c.LaneWidth,.04,-d),{67,87,80})
        end
    end
    local obstacles,supplies={},{}
    local types={"jump","slide","block"}
    for i=1,24 do
        local lane=(i%3)-1;local d=55+i*32;local kind=types[(i%3)+1]
        local size=kind=="jump" and Vector3.new(5,2.6,2) or kind=="slide" and Vector3.new(6,2,2) or Vector3.new(5,7,3)
        local y=kind=="slide" and 5.5 or size.Y/2
        local p=part(folder,"Obstacle_"..i,size,Vector3.new(lane*c.LaneWidth,y,-d),{68,93,82})
        if kind=="slide" then
            for _,side in ipairs({-1,1}) do part(folder,"Arch support",Vector3.new(.35,6,.5),Vector3.new(lane*c.LaneWidth+side*3.15,3,-d),{46,68,63}) end
        end
        part(folder,"Hazard marking",Vector3.new(3,.12,.12),Vector3.new(lane*c.LaneWidth,y+size.Y/2+.1,-d+1.2),{146,192,148},Enum.Material.Neon)
        table.insert(obstacles,{id=i,lane=lane,d=d,kind=kind})
    end
    for i=1,42 do
        local d=20+i*20;local lane=i%2==0 and 0 or ((i%3)-1)
        local p=part(folder,"Supply_"..i,Vector3.new(1,1,1),Vector3.new(lane*c.LaneWidth,2,-d),{93,201,165},Enum.Material.Neon)
        p.Orientation=Vector3.new(20,45,20)
        table.insert(supplies,{id=i,lane=lane,d=d})
    end
    for _,d in ipairs({180,c.Length}) do
        for _,side in ipairs({-1,1}) do part(folder,"Story pillar",Vector3.new(2,12,2),Vector3.new(side*14,6,-d),{43,76,73}) end
        part(folder,"Story arch",Vector3.new(30,1,2),Vector3.new(0,12,-d),{52,137,132},Enum.Material.Neon)
    end
    local spawn=Instance.new("SpawnLocation");spawn.Name="ForestStart";spawn.Anchored=true;spawn.Neutral=true;spawn.Duration=0
    spawn.Transparency=1;spawn.CanCollide=false;spawn.Size=Vector3.new(4,1,4);spawn.Position=Vector3.new(0,3,0);spawn.Parent=folder
    return obstacles,supplies
end
return World
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Script" referent="RBX30">
        <Properties>
          <string name="Name">Main</string>
          <ProtectedString name="Source">local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local RunService=game:GetService("RunService")
local shared=RS:WaitForChild("Sapiens")
local Config=require(shared.Config)
local Rules=require(shared.Rules)
local obstacles,supplies=require(script.Parent.World).build(Config)
Players.RespawnTime=Config.RespawnSeconds
local action=Instance.new("RemoteEvent");action.Name="Action";action.Parent=shared
local update=Instance.new("RemoteEvent");update.Name="State";update.Parent=shared
local sessions={}
local store=nil
if not RunService:IsStudio() or Config.EnableStudioSaves then
    local ok,value=pcall(function()return game:GetService("DataStoreService"):GetDataStore(Config.DataStoreName) end)
    if ok then store=value end
end
local function snapshot(player,s,event)
    local collected={}
    for id in pairs(s.collected) do collected[tostring(id)]=true end
    update:FireClient(player,{mode=s.mode,hits=s.hits,distance=math.floor(s.distance),supplies=s.supplies,
        knowledge=s.knowledge,insight=s.insight,best=s.best,wins=s.wins,event=event,
        saveStatus=s.saveStatus,collected=collected})
end
local function save(player,s)
    if not store or not s.canSave or s.saving then return end
    s.saving=true
    local best,wins,insight=s.best,s.wins,s.insight
    local ok=pcall(function()
        store:UpdateAsync(tostring(player.UserId),function(old)
            old=type(old)=="table" and old or {}
            return {version=1,best=math.max(tonumber(old.best) or 0,best),
                wins=math.max(tonumber(old.wins) or 0,wins),insight=old.insight==true or insight}
        end)
    end)
    s.saveStatus=ok and "Saved" or "Save failed; will retry";s.saving=false
end
local function character(player,model)
    local root=model:WaitForChild("HumanoidRootPart",10)
    local humanoid=model:WaitForChild("Humanoid",10)
    local s=sessions[player];if not s or not root or not humanoid then return end
    root.Anchored=true;humanoid.AutoRotate=false;humanoid.WalkSpeed=0;humanoid.JumpPower=0
    for _,p in ipairs(model:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide=false end end
    model.PrimaryPart=root
    local animate=model:FindFirstChild("Animate");if animate then animate.Disabled=true end
    s.root=root;s.humanoid=humanoid;s.character=model
    if s.mode=="dead" then Rules.respawn(s) end
    model:PivotTo(CFrame.new(0,3,0))
    humanoid.Died:Connect(function()if sessions[player] then s.mode="dead";snapshot(player,s,"Death") end end)
    snapshot(player,s)
end
local function join(player)
    local s=Rules.new();s.lastInput=0;s.report=0;s.canSave=false;s.saveStatus=store and "Loading save" or "Session only (Studio saves off)"
    if store then s.mode="loading" end
    sessions[player]=s
    player.CharacterAdded:Connect(function(model)character(player,model)end)
    if player.Character then task.spawn(character,player,player.Character) end
    if store then
        local ok,data=pcall(function()return store:GetAsync(tostring(player.UserId))end)
        if sessions[player]~=s then return end
        if ok then
            if type(data)=="table" and data.version==1 then
                s.best=math.max(s.best,math.min(900,tonumber(data.best) or 0));s.wins=math.max(0,tonumber(data.wins) or 0)
                s.insight=data.insight==true or s.insight;s.knowledge=s.insight and 12 or 0
            end
            s.canSave=true;s.saveStatus="Save ready"
        else s.canSave=false;s.saveStatus="Save unavailable; session progress only" end
        if s.mode=="loading" then s.mode="ready" end
        snapshot(player,s)
    end
end
Players.PlayerAdded:Connect(join)
for _,p in ipairs(Players:GetPlayers()) do task.spawn(join,p) end
Players.PlayerRemoving:Connect(function(p)local s=sessions[p];if s then save(p,s) end;sessions[p]=nil end)
action.OnServerEvent:Connect(function(player,verb,value)
    local s=sessions[player]
    if not s or type(verb)~="string" then return end
    local now=os.clock();if now-s.lastInput&lt;.07 then return end;s.lastInput=now
    if verb=="sync" then snapshot(player,s);return end
    if verb=="start" and s.root and s.humanoid.Health&gt;0 and (s.mode=="ready" or s.mode=="return" or s.mode=="complete") then
        if s.mode=="complete" then s.supplies=0;s.collected={};s.storySeen=false end
        Rules.respawn(s)
    elseif verb=="pause" and s.mode=="running" then s.mode="paused"
    elseif verb=="resume" and s.mode=="paused" then s.mode="running"
    elseif verb=="answer" then
        if Rules.answer(s,value) then snapshot(player,s,"Discovery");task.spawn(save,player,s);return end
    else Rules.input(s,verb,Config) end
    snapshot(player,s)
end)
RunService.Heartbeat:Connect(function(dt)
    for p,s in pairs(sessions) do
        if s.root and s.root.Parent and s.humanoid.Health&gt;0 then
            local event=Rules.step(s,dt,Config,obstacles,supplies)
            if s.mode=="dead" then s.humanoid.Health=0
            else
                local h=Rules.height(s,Config)
                local sliding=s.slide&gt;0
                s.character:PivotTo(CFrame.new(s.x,sliding and 1.35 or 3+h,-s.distance)*CFrame.Angles(sliding and -math.pi/2 or 0,0,0))
            end
            s.report=s.report+dt
            if event or s.report&gt;.1 then s.report=0;snapshot(p,s,event) end
            if event=="Complete" then task.spawn(save,p,s) end
        end
    end
end)
task.spawn(function()while task.wait(60) do for p,s in pairs(sessions) do task.spawn(save,p,s) end end end)
game:BindToClose(function()
    local pending=0
    for p,s in pairs(sessions) do pending=pending+1;task.spawn(function()save(p,s);pending=pending-1 end) end
    local untilTime=os.clock()+25;while pending&gt;0 and os.clock()&lt;untilTime do task.wait(.1) end
end)
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX34">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX37">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="RBX40">
        <Properties>
          <string name="Name">SapiensClient</string>
          <ProtectedString name="Source">local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local RunService=game:GetService("RunService")
local CAS=game:GetService("ContextActionService")
local SoundService=game:GetService("SoundService")
local player=Players.LocalPlayer
local shared=RS:WaitForChild("Sapiens")
local c=require(shared.Config)
local action=shared:WaitForChild("Action")
local update=shared:WaitForChild("State")
local state={mode="loading",collected={}}
local muted=false
local gui=Instance.new("ScreenGui");gui.Name="SapiensHUD";gui.ResetOnSpawn=false;gui.Parent=player:WaitForChild("PlayerGui")
local function label(parent,text,size,pos)
    local l=Instance.new("TextLabel");l.BackgroundTransparency=1;l.Size=size;l.Position=pos
    l.Text=text;l.Font=Enum.Font.Gotham;l.TextSize=16;l.TextColor3=Color3.fromRGB(218,238,225);l.TextWrapped=true;l.Parent=parent;return l
end
local function button(parent,text,size,pos,callback)
    local b=Instance.new("TextButton");b.Text=text;b.Size=size;b.Position=pos;b.Font=Enum.Font.GothamBold;b.TextSize=15
    b.BackgroundColor3=Color3.fromRGB(34,83,72);b.TextColor3=Color3.fromRGB(224,242,231);b.Parent=parent
    local round=Instance.new("UICorner");round.CornerRadius=UDim.new(0,10);round.Parent=b
    b.Activated:Connect(callback);return b
end
local bar=Instance.new("Frame");bar.Size=UDim2.new(1,0,0,94);bar.BackgroundColor3=Color3.fromRGB(8,26,31);bar.BackgroundTransparency=.1;bar.Parent=gui
local status=label(bar,"Loading the forest…",UDim2.new(1,-170,0,45),UDim2.fromOffset(10,0))
local progress=label(bar,"",UDim2.new(1,-20,0,42),UDim2.fromOffset(10,45));progress.TextSize=13
button(bar,"Pause",UDim2.fromOffset(70,38),UDim2.new(1,-160,0,5),function()action:FireServer(state.mode=="paused" and "resume" or "pause")end)
local music=Instance.new("Sound");music.Name="ForestDrone";music.Looped=true;music.Volume=.42;music.Parent=SoundService
if c.Audio.Music&gt;0 then music.SoundId="rbxassetid://"..c.Audio.Music end
local muteButton
muteButton=button(bar,"Sound on",UDim2.fromOffset(78,38),UDim2.new(1,-82,0,5),function()
    muted=not muted;music.Volume=muted and 0 or .42;muteButton.Text=muted and "Muted" or "Sound on"
end)
local panel=Instance.new("Frame");panel.AnchorPoint=Vector2.new(.5,.5);panel.Position=UDim2.fromScale(.5,.5);panel.Size=UDim2.new(.9,0,.62,0)
panel.BackgroundColor3=Color3.fromRGB(8,30,34);panel.Parent=gui
local limit=Instance.new("UISizeConstraint");limit.MaxSize=Vector2.new(600,430);limit.Parent=panel
local title=label(panel,c.Title,UDim2.new(1,-30,.18,0),UDim2.fromOffset(15,5));title.TextSize=22;title.Font=Enum.Font.GothamBold
local body=label(panel,"",UDim2.new(1,-30,.43,0),UDim2.new(0,15,.18,0));body.TextSize=15
local primary=button(panel,"Enter the forest",UDim2.new(1,-30,.15,0),UDim2.new(0,15,.65,0),function()
    if state.mode=="story" then action:FireServer("answer",1)
    elseif state.mode=="paused" then action:FireServer("resume")
    else action:FireServer("start") end
end)
local secondary=button(panel,"Trust happens automatically",UDim2.new(1,-30,.15,0),UDim2.new(0,15,.82,0),function()
    body.Text="Consider the alternative: strangers do not automatically trust each other. In Sapiens, shared stories are one explanation for cooperation. Try the shared-symbol choice."
end)
local controls=Instance.new("Frame");controls.BackgroundTransparency=1;controls.Size=UDim2.new(1,-20,0,55);controls.Position=UDim2.new(0,10,1,-65);controls.Parent=gui
for i,item in ipairs({{"Left","left"},{"Jump","jump"},{"Slide","slide"},{"Right","right"}}) do
    local verb=item[2]
    button(controls,item[1],UDim2.new(.24,0,1,0),UDim2.fromScale((i-1)*.253,0),function()action:FireServer(verb)end)
end
local bindings={left={Enum.KeyCode.A,Enum.KeyCode.Left,Enum.KeyCode.DPadLeft},right={Enum.KeyCode.D,Enum.KeyCode.Right,Enum.KeyCode.DPadRight},jump={Enum.KeyCode.Space,Enum.KeyCode.W,Enum.KeyCode.ButtonA},slide={Enum.KeyCode.S,Enum.KeyCode.Down,Enum.KeyCode.ButtonB}}
for verb,keys in pairs(bindings) do
    CAS:BindActionAtPriority("Sapiens_"..verb,function(_,inputState)
        if inputState==Enum.UserInputState.Begin then action:FireServer(verb) end
        return Enum.ContextActionResult.Sink
    end,false,3000,table.unpack(keys))
end
local function effect(name)
    local id=c.Audio[name];if muted or not id or id&lt;=0 then return end
    local sound=Instance.new("Sound");sound.SoundId="rbxassetid://"..id;sound.Volume=.35;sound.Parent=SoundService;sound:Play()
    game:GetService("Debris"):AddItem(sound,8)
end
update.OnClientEvent:Connect(function(s)
    state=s
    status.Text=string.format("FOREST OF STORIES   •   %dm   •   Impacts %d/2",s.distance,s.hits)
    progress.Text=string.format("Supplies %d/%d   |   Insight %s   |   Best %dm   |   %s",s.supplies,c.SuppliesRequired,s.insight and "✓" or "0/1",s.best,s.saveStatus or "Session")
    panel.Visible=s.mode~="running";secondary.Visible=s.mode=="story";primary.Visible=s.mode~="dead" and s.mode~="loading"
    controls.Visible=s.mode=="running"
    if s.mode=="loading" then title.Text="Entering the forest";body.Text="Loading your saved discoveries…"
    elseif s.mode=="ready" then
        title.Text=c.Title;primary.Text="Enter the forest"
        body.Text="Run the ancient trail. Gather 8 supplies, discover an idea, and reach 900m. Two obstacle impacts cause death and automatic respawn. A/D: lanes • Space: jump logs • S: slide under arches. Dodge standing stones. Touch controls below."
        if c.Audio.Music==0 then body.Text=body.Text.."\nAudio awaits asset IDs; see the setup guide." end
    elseif s.mode=="story" then
        title.Text="Quest: The painted cave";primary.Text="Create a shared symbol and story"
        body.Text="Two unfamiliar bands reach the same shelter. What might help them cooperate?\nSapiens explores shared stories as one basis for large-scale cooperation. This is a book-inspired interpretation, not a universal historical law. Choose a response to gain +12 knowledge once."
    elseif s.mode=="dead" then title.Text="Your journey falters";body.Text="Two impacts. Returning to the starting point… Your supplies and insight are retained."
    elseif s.mode=="paused" then title.Text="Rest beside the trail";body.Text="Your run is paused. No movement or collisions while this panel is open.";primary.Text="Resume"
    elseif s.mode=="complete" then title.Text="Chapter complete";body.Text="You reached the end, gathered supplies and discovered an idea. This starter contains the Cognitive chapter only. Your best distance, insight and completed-run count can be saved.";primary.Text="Play again"
    elseif s.mode=="return" then title.Text="One more journey";body.Text="Reach the arch with 8 supplies and the story insight. Return to collect the supplies you missed. Your progress is retained.";primary.Text="Return to the start" end
    if s.event=="Death" then effect("Hit") else effect(s.event) end
    if c.Audio.Music&gt;0 then
        if s.mode=="running" and not music.IsPlaying then music:Resume();if not music.IsPlaying then music:Play() end
        elseif s.mode~="running" then music:Pause() end
    end
    local world=workspace:FindFirstChild("SapiensForest")
    if world then
        for _,p in ipairs(world:GetChildren()) do
            local id=tonumber(string.match(p.Name,"^Supply_(%d+)$"))
            if id then p.LocalTransparencyModifier=(s.collected[id] or s.collected[tostring(id)]) and 1 or 0 end
        end
    end
end)
local joints={}
local function prepareCharacter(model)
    joints={}
    for _,joint in ipairs(model:GetDescendants()) do
        if joint:IsA("Motor6D") and (string.find(joint.Name,"Hip") or string.find(joint.Name,"Shoulder")) then table.insert(joints,joint) end
    end
end
player.CharacterAdded:Connect(prepareCharacter)
if player.Character then prepareCharacter(player.Character) end
RunService.RenderStepped:Connect(function(dt)
    local camera=workspace.CurrentCamera
    local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if root then
        camera.CameraType=Enum.CameraType.Scriptable
        local target=root.Position
        camera.CFrame=camera.CFrame:Lerp(CFrame.lookAt(target+Vector3.new(0,9,17),target+Vector3.new(0,2,-18)),1-math.exp(-dt*8))
        for _,joint in ipairs(joints) do
            local side=string.find(joint.Name,"Left") and -1 or 1
            joint.Transform=CFrame.Angles(state.mode=="running" and math.sin(os.clock()*10)*.5*side or 0,0,0)
        end
    end
end)
action:FireServer("sync")
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="Lighting" referent="RBX44">
    <Properties>
      <string name="Name">Lighting</string>
    </Properties>
  </Item>
</roblox>